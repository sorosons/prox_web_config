# Copy to .env on the server and fill in. Never commit the real .env.
#
#   cp .env.example .env
#
# Generate the two secrets on the server:
#   openssl rand -base64 18   -> PANEL_PASSWORD
#   openssl rand -hex 32      -> SESSION_SECRET

PANEL_PASSWORD=
SESSION_SECRET=

# Absolute path on the SERVER to the Firebase service account JSON.
# Keep it outside this directory so a stray `git add -A` cannot reach it.
SERVICE_ACCOUNT_PATH=/etc/prox-panel/service-account.json
